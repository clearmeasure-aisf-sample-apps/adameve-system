@startuml 01-octopus-foothold
!include _c4.iuml
title Adam and woman in the garden of Eden | Phase 1: Octopus foothold (2026-10-08)

Boundary(box, "Operator machine omarchy") {
  Container(aiops, "Linux user aiops", "Claude Code, gh, az, pwsh", "Ran new-octopus-foothold.ps1")
}

Boundary(octo, "Octopus https://clearmeasure.octopus.app") {
  Container(aiops_octo, "ai-ops", "AI service account", "Octopus Managers")
  Boundary(space, "Space Adam and woman in the garden of Eden (Spaces-395, slug adam-and-woman-in-the-garden-of-eden)") {
    Container(sa, "adameve-github", "service account Users-866, Space Manager", "No password, no API key: GitHub signs in with OIDC (ExternalId e2f51e0d-acc0-44f3-8e98-09d7f4e9fee9)", $tags="new")
    Container(oidc_sys, "OIDC identity", "issuer token.actions.githubusercontent.com", "repo:clearmeasure-aisf-sample-apps/adameve-system:environment:octopus", $tags="new")
    Container(oidc_app, "OIDC identity", "issuer token.actions.githubusercontent.com", "repo:clearmeasure-aisf-sample-apps/adameve-app:environment:release", $tags="new")
  }
}

Boundary(gh, "GitHub org clearmeasure-aisf-sample-apps") {
  Container(sysrepo, "adameve-system", "environment octopus", "Jobs octopus-apply and system-release", $tags="planned")
  Container(apprepo, "adameve-app", "environment release", "Workflow release.yml", $tags="planned")
}

Rel(aiops, aiops_octo, "REST", "API key")
Rel(aiops_octo, space, "created; Space Manager", $tags="new")
Rel(oidc_sys, sa, "signs in as", $tags="new")
Rel(oidc_app, sa, "signs in as", $tags="new")
Rel(sysrepo, oidc_sys, "OIDC token", $tags="planned")
Rel(apprepo, oidc_app, "OIDC token", $tags="planned")

SHOW_LEGEND()
@enduml
